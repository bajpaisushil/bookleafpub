# Server
PORT=4000
NODE_ENV=development
# Origin of the web app (used for CORS when the API is called directly)
WEB_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://bookleaf:bookleaf@localhost:5432/bookleaf

# Auth: use a long random string in production (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# AI: "anthropic", "openai" or "none" (rules + templates only)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides (defaults depend on the provider)
AI_CLASSIFY_MODEL=
AI_DRAFT_MODEL=
